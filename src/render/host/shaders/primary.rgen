#version 460
// glslang only honours #include when this is enabled first.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(location = 0) rayPayloadEXT HitPayload payload;

void main()
{
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 uv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);

    // Y is inverted, not merely scaled. gl_LaunchIDEXT.y counts down from the
    // top row, and imageStore and the file writer both keep that order, but
    // the matrix being inverted is Direct3D's, where NDC y is +1 at the TOP.
    // Without the flip every traced frame comes out vertically mirrored —
    // which the self-test scene is far too symmetric to notice.
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);

    // The ray is built from the same inverse view-projection the world
    // transforms were factored with. That matters: the recovered basis is
    // only defined up to an affine change of basis, so the camera and the
    // geometry must come from the same matrix or they will not agree.
    const vec3 origin = UnprojectToWorld(ndc, 0.0);
    const vec3 target = UnprojectToWorld(ndc, 1.0);
    const vec3 dir    = normalize(target - origin);

    // ── Peel the transparent layers, front to back ───────────────────────
    // See HitPayload in common.glsl for why this is a loop rather than one
    // trace: the game composites blended surfaces in draw order and shading
    // only the nearest one paints markings, shirt numbers and shadows as
    // solid patches.
    vec3  accumulated  = vec3(0.0);
    float transmittance = 1.0;
    float tmin = 0.0;

    for (int layer = 0; layer < kMaxLayers; ++layer)
    {
        payload.colour = vec3(0.0);
        payload.alpha  = 0.0;
        payload.dist   = -1.0;

        // No gl_RayFlagsOpaqueEXT: that flag forces every hit opaque, which
        // skips the any-hit shader and with it the alpha test. Opacity is
        // decided per instance by the builder.
        traceRayEXT(topLevel,
                    0,
                    kMaskPrimary,  // the sky is not among these
                    0,             // sbtRecordOffset
                    0,             // sbtRecordStride
                    0,             // missIndex: the sky shader
                    origin, tmin,
                    dir, 1.0e9,
                    0);            // payload location

        if (payload.dist < 0.0)
        {
            // ── The background ───────────────────────────────────────────
            //
            // The game's sky is a textured box around the camera, drawn with
            // depth writes off. It cannot be traced with everything else -
            // it encloses the viewer, so every primary ray would hit it
            // first - so it sits on its own mask and is looked up here,
            // once, after the scene has been exhausted.
            //
            // This is a second trace from the ray generation rather than one
            // from inside the miss shader, which keeps the recursion depth
            // at two: the sky's record is unlit, so its hit shader traces
            // nothing. If the box does not cover this direction - or there
            // is no sky in the scene at all, as on the menus - the same miss
            // shader runs again and leaves its gradient, which is the right
            // fallback and cannot recurse.
            traceRayEXT(topLevel,
                        gl_RayFlagsOpaqueEXT,   // the box is solid
                        kMaskSky,
                        0, 0, 0,
                        origin, tmin,
                        dir, 1.0e9,
                        0);

            accumulated += transmittance * payload.colour;
            transmittance = 0.0;
            break;
        }

        const float a = clamp(payload.alpha, 0.0, 1.0);
        accumulated   += transmittance * a * payload.colour;
        transmittance *= (1.0 - a);

        // Nothing behind this can still be seen.
        if (transmittance < 1.0 / 255.0) break;

        // Resume just past the hit. The offset scales with distance because
        // floating-point precision does: a fixed epsilon either re-hits the
        // same surface far away or skips past a near one.
        tmin = payload.dist * (1.0 + 1.0e-5) + 1.0e-3;
    }

    const float exposure = max(scene.params.y, 1e-3);
    vec3 color = accumulated * exposure;

    // The game's colours are already in low dynamic range, so this is a
    // gamma encode rather than a tonemap; anything stronger would crush the
    // baked lighting the scene depends on.
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / 2.2));

    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
}
