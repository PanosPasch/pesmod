#version 460
// glslang only honours #include when this is enabled first.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(location = 0) rayPayloadEXT HitPayload payload;

void main()
{
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 uv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);

    // Y is inverted, not merely scaled. gl_LaunchIDEXT.y counts down from the
    // top row, and imageStore and the file writer both keep that order, but
    // the matrix being inverted is Direct3D's, where NDC y is +1 at the TOP.
    // Without the flip every traced frame comes out vertically mirrored —
    // which the self-test scene is far too symmetric to notice.
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);

    // The ray is built from the same inverse view-projection the world
    // transforms were factored with. That matters: the recovered basis is
    // only defined up to an affine change of basis, so the camera and the
    // geometry must come from the same matrix or they will not agree.
    const vec3 origin = UnprojectToWorld(ndc, 0.0);
    const vec3 target = UnprojectToWorld(ndc, 1.0);
    const vec3 dir    = normalize(target - origin);

    // ── A debug view short-circuits the whole composite ──────────────────
    //
    // One trace, forced opaque so the nearest surface wins outright, and the
    // hit shader's answer written out raw. Peeling and tonemapping would both
    // get in the way of reading a value off the image.
    const uint debugView = uint(scene.debug.x + 0.5);
    if (debugView != kDebugOff && debugView != kDebugLayers &&
        debugView != kDebugLeftover)
    {
        // debug.y steps past the nearest hits, so a term can be read off a
        // surface that something else is composited in front of. Forced
        // opaque, so this walks geometric hits and the any-hit shader cannot
        // quietly change which surface is being looked at. tmin advances
        // exactly as the real peel advances it.
        const int skipHits = int(scene.debug.y + 0.5);
        float dtmin = 0.0;
        for (int step = 0; step <= skipHits; ++step)
        {
            payload.colour = vec3(0.0);
            payload.alpha  = 0.0;
            payload.dist   = -1.0;

            traceRayEXT(topLevel, gl_RayFlagsOpaqueEXT, kMaskPrimary,
                        0, 0, 0, origin, dtmin, dir, 1.0e9, 0);

            if (payload.dist < 0.0 || step == skipHits) break;
            dtmin = payload.dist +
                    max(payload.dist * scene.decal.x * scene.decal.y, 1.0e-4);
        }

        // A miss stays black, so background and geometry cannot be confused.
        const vec3 shown = (payload.dist < 0.0) ? vec3(0.0) : payload.colour;
        imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(shown, 1.0));
        return;
    }

    // ── Peel the transparent layers, front to back ───────────────────────
    // See HitPayload in common.glsl for why this is a loop rather than one
    // trace: the game composites blended surfaces in draw order and shading
    // only the nearest one paints markings, shirt numbers and shadows as
    // solid patches.
    vec3  accumulated  = vec3(0.0);
    float transmittance = 1.0;
    float tmin = 0.0;

    // How many layers this pixel actually consumed, which is the one thing
    // about the composite that the finished image cannot show. A pixel that
    // runs the loop out has its remaining transmittance dropped, and comes
    // out dark for a reason no single surface explains.
    int layersUsed = 0;
    bool ranOut = true;

    for (int layer = 0; layer < kMaxLayers; ++layer)
    {
        ++layersUsed;
        payload.colour = vec3(0.0);
        payload.alpha  = 0.0;
        payload.dist   = -1.0;

        // No gl_RayFlagsOpaqueEXT: that flag forces every hit opaque, which
        // skips the any-hit shader and with it the alpha test. Opacity is
        // decided per instance by the builder.
        traceRayEXT(topLevel,
                    0,
                    kMaskPrimary,  // the sky is not among these
                    0,             // sbtRecordOffset
                    0,             // sbtRecordStride
                    0,             // missIndex: the sky shader
                    origin, tmin,
                    dir, 1.0e9,
                    0);            // payload location

        if (payload.dist < 0.0)
        {
            ranOut = false;
            // ── The background ───────────────────────────────────────────
            //
            // The game's sky is a textured box around the camera, drawn with
            // depth writes off. It cannot be traced with everything else -
            // it encloses the viewer, so every primary ray would hit it
            // first - so it sits on its own mask and is looked up here,
            // once, after the scene has been exhausted.
            //
            // This is a second trace from the ray generation rather than one
            // from inside the miss shader, which keeps the recursion depth
            // at two: the sky's record is unlit, so its hit shader traces
            // nothing. If the box does not cover this direction - or there
            // is no sky in the scene at all, as on the menus - the same miss
            // shader runs again and leaves its gradient, which is the right
            // fallback and cannot recurse.
            traceRayEXT(topLevel,
                        gl_RayFlagsOpaqueEXT,   // the box is solid
                        kMaskSky,
                        0, 0, 0,
                        origin, tmin,
                        dir, 1.0e9,
                        0);

            accumulated += transmittance * payload.colour;
            transmittance = 0.0;
            break;
        }

        const float a = clamp(payload.alpha, 0.0, 1.0);
        accumulated   += transmittance * a * payload.colour;
        transmittance *= (1.0 - a);

        // Nothing behind this can still be seen.
        if (transmittance < 1.0 / 255.0) { ranOut = false; break; }

        // ── Resume just past the hit ─────────────────────────────────────
        //
        // Scaled by distance, because floating-point precision is: a fixed
        // epsilon either re-hits the same surface far away or steps past a
        // near one.
        //
        // And strictly inside one decal step, which is the part that was
        // wrong. The builder places a decal one step in front of what it
        // decorates; an epsilon of a whole step therefore landed past the
        // base surface every time, and the base was never composited. On the
        // pitch that meant the grass was skipped and what remained was a
        // near-black wear overlay at 5% alpha over whatever lay beyond -
        // which read as a flat blue-grey where the grass should be.
        //
        // The floor keeps it non-zero for a hit at the origin.
        const float step = payload.dist * scene.decal.x;
        tmin = payload.dist + max(step * scene.decal.y, 1.0e-4);
    }

    if (debugView == kDebugLayers || debugView == kDebugLeftover)
    {
        // Layers as a ramp from green to red, with a pixel that exhausted
        // the loop flagged blue so it cannot be mistaken for one that merely
        // used a lot; leftover transmittance as plain grey.
        vec3 shown;
        if (debugView == kDebugLayers)
        {
            const float f = float(layersUsed) / float(kMaxLayers);
            shown = ranOut ? vec3(f, 0.0, 1.0) : vec3(f, 1.0 - f, 0.0);
        }
        else
        {
            shown = vec3(transmittance);
        }
        imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(shown, 1.0));
        return;
    }

    const float exposure = max(scene.params.y, 1e-3);
    vec3 color = accumulated * exposure;

    // ── Not calibrated, and known not to be ─────────────────────────────
    //
    // The game is Direct3D 8 fixed function: its output is already
    // display-referred, so encoding again here is, strictly, encoding twice.
    // Removing it was measured against a frame where the game and this
    // renderer sit side by side, and it is not simply better - it fixes one
    // region and breaks two:
    //
    //                    game            with encode     without
    //   pitch            76,  95,  51    157,173,138     89,110, 69
    //   crowd            58,  52,  50     93, 92, 88     30, 29, 26
    //   hoarding red    156,  98, 106    121,100,101     57, 41, 41
    //
    // Which says the error is not the encode alone. The game bakes its
    // lighting into vertex colours and this renderer replaces that with a
    // traced rig; the two disagree by different amounts on different
    // surfaces, and no single curve fixes that. Calibrating the rig against
    // the game is its own piece of work, and until it is done this stays as
    // it is rather than trading one wrong answer for another.
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / 2.2));

    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
}
