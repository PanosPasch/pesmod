# ...except the vendored MinHook binaries, which are required to build
# and to run (MinHook.x86.lib is an import lib for MinHook.x86.dll).
!include/MinHook/lib/MinHook.x86.lib
!include/MinHook/lib/MinHook.x86.dll

# Vite / Node viewer
node_modules/
tools/ui-bin-viewer/dist/
tools/ui-bin-viewer/.vite/
tools/ui-bin-viewer/.vite-cache/

# Logs and local diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Local environment files
.env
.env.*
!.env.example

# Traced output from the self-test, written next to wherever it is run from.
astest*.ppm
astest*.png
traced_frame*.png
